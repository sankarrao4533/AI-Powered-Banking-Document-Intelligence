# ==============================================================================
# Sentinel Banking Document Intelligence Configuration
# ==============================================================================

# Storage Engine: 'auto' (detects Neo4j, falls back to embedded SQLite/NetworkX),
# 'embedded' (zero external dependencies), or 'neo4j'
STORAGE_MODE=auto

# Enterprise Neo4j Settings (Optional - only needed if using Neo4j)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM Providers (At least one recommended for grounded text generation)
# 1. Groq (Fast Llama-3.3-70B inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# 2. Google Gemini (Multimodal PDF/Image table parsing & grounded synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 3. OpenAI (Optional)
OPENAI_API_KEY=

# Local Semantic Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
